{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall/schemas/evaluation/task/v1",
  "title": "Heimdall evaluation task v1",
  "description": "Record shape for one evaluation task. Every task carries provenance, version, permitted use, and executable or rubric-based success criteria.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,127}$", "maxLength": 128 },
    "family": {
      "type": "string",
      "enum": [
        "bug-fix",
        "test-writing",
        "refactor",
        "documentation",
        "explanation",
        "tool-heavy",
        "ambiguous-follow-up",
        "chat",
        "rag",
        "modality-rejection"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "dataset": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
        "commit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "instanceId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "license": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["dataset", "license"],
      "additionalProperties": false
    },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "success": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["executable", "rubric"] },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "rubricRef": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "split": { "type": "string", "enum": ["train", "tune", "test", "example"] },
    "sandbox": {
      "type": "object",
      "properties": {
        "needs": { "type": "string", "minLength": 1, "maxLength": 512 },
        "network": { "type": "boolean" }
      },
      "required": ["needs", "network"],
      "additionalProperties": false
    }
  },
  "required": ["id", "family", "source", "prompt", "success", "split", "sandbox"],
  "additionalProperties": false
}
