# Heimdall environment variable names only. Never commit values.
# Copy to .env for local development; .env is git-ignored.

# PostgreSQL connection string for the gateway (T020+). Example name only.
HEIMDALL_DATABASE_URL=

# TypeSafe/Jev API key for the semantic adapter (T025+). Keyless tests use fakes.
HEIMDALL_JEV_API_KEY=

# OpenRouter API key for the completion adapter (T031+). Keyless tests use fakes.
HEIMDALL_OPENROUTER_API_KEY=

# Gateway admin API key(s) for restricted publish/rollback endpoints (T022+).
HEIMDALL_ADMIN_API_KEY=
