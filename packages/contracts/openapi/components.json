{
  "components": {
    "schemas": {
      "applicationProfile": {
        "description": "Required caller application profile. Coding agents retain models per task; chat and RAG route per invocation.",
        "enum": ["coding-agent", "chat", "rag"],
        "title": "ApplicationProfile",
        "type": "string"
      },
      "attemptId": {
        "description": "Identifier for one model invocation attempt within a decision.",
        "maxLength": 100,
        "pattern": "^att_[A-Za-z0-9_-]{8,96}$",
        "title": "AttemptId",
        "type": "string"
      },
      "audioBlock": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 200000,
            "type": "string"
          },
          "mimeType": {
            "$ref": "#/components/schemas/mimeType"
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/urlSource"
              },
              {
                "$ref": "#/components/schemas/refSource"
              }
            ]
          },
          "type": {
            "const": "audio"
          }
        },
        "required": ["type", "source"],
        "title": "AudioBlock",
        "type": "object"
      },
      "budgetPolicy": {
        "additionalProperties": false,
        "description": "Declared money bounds. Hard caps gate admission; soft targets influence ranking only. Ledger mechanics belong to later tasks.",
        "properties": {
          "hardCap": {
            "$ref": "#/components/schemas/money"
          },
          "softTarget": {
            "$ref": "#/components/schemas/money"
          }
        },
        "required": ["hardCap"],
        "title": "BudgetPolicy",
        "type": "object"
      },
      "candidateId": {
        "description": "Opaque model-candidate identifier (provider, model/version, and material configuration).",
        "maxLength": 100,
        "pattern": "^cand_[A-Za-z0-9_-]{8,96}$",
        "title": "CandidateId",
        "type": "string"
      },
      "candidateProfile": {
        "additionalProperties": false,
        "description": "Versioned model-candidate record. `fixture` marks unmistakably synthetic development data barred from production.",
        "properties": {
          "candidateId": {
            "$ref": "#/components/schemas/candidateId"
          },
          "capacity": {
            "$ref": "#/components/schemas/safeCapacity"
          },
          "endpoints": {
            "$ref": "#/components/schemas/endpointPolicy"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/evidenceRecord"
            },
            "maxItems": 128,
            "minItems": 1,
            "type": "array"
          },
          "fixture": {
            "type": "boolean"
          },
          "modalities": {
            "$ref": "#/components/schemas/modalitySupport"
          },
          "model": {
            "$ref": "#/components/schemas/modelRef"
          },
          "prices": {
            "$ref": "#/components/schemas/priceSchedule"
          },
          "providerFamily": {
            "$ref": "#/components/schemas/providerFamily"
          },
          "revision": {
            "$ref": "#/components/schemas/revisionId"
          },
          "tools": {
            "$ref": "#/components/schemas/toolSupport"
          }
        },
        "required": [
          "candidateId",
          "revision",
          "providerFamily",
          "model",
          "modalities",
          "tools",
          "capacity",
          "endpoints",
          "prices",
          "evidence",
          "fixture"
        ],
        "title": "CandidateProfile",
        "type": "object"
      },
      "capabilityState": {
        "description": "Hard capability evidence status. Unknown is first-class and never treated as verified support or as false.",
        "enum": ["unknown", "verified", "unsupported"],
        "title": "CapabilityState",
        "type": "string"
      },
      "contentBlock": {
        "description": "Any single content block across all declared modalities.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/textBlock"
          },
          {
            "$ref": "#/components/schemas/imageBlock"
          },
          {
            "$ref": "#/components/schemas/audioBlock"
          },
          {
            "$ref": "#/components/schemas/videoBlock"
          },
          {
            "$ref": "#/components/schemas/fileBlock"
          },
          {
            "$ref": "#/components/schemas/mixedBlock"
          }
        ],
        "title": "ContentBlock"
      },
      "contextRequirements": {
        "additionalProperties": false,
        "description": "Advisory context needs used for candidate-specific token-fit checks.",
        "properties": {
          "requiredInputTokens": {
            "$ref": "#/components/schemas/tokenCount"
          },
          "requiredOutputTokens": {
            "$ref": "#/components/schemas/tokenCount"
          }
        },
        "title": "ContextRequirements",
        "type": "object"
      },
      "currency": {
        "description": "Three-letter uppercase currency code (ISO-4217-shaped). A full allowlist is deferred to real price ingestion (T032).",
        "pattern": "^[A-Z]{3}$",
        "title": "Currency",
        "type": "string"
      },
      "decimalAmount": {
        "description": "Exact decimal money string. Binary floats are never used for billing arithmetic.",
        "maxLength": 32,
        "pattern": "^-?\\d{1,18}(\\.\\d{1,9})?$",
        "title": "DecimalAmount",
        "type": "string"
      },
      "decisionId": {
        "description": "Identifier for one routing decision, not a task.",
        "maxLength": 100,
        "pattern": "^dec_[A-Za-z0-9_-]{8,96}$",
        "title": "DecisionId",
        "type": "string"
      },
      "dependencyVersions": {
        "additionalProperties": false,
        "description": "Exact dependency revisions behind a decision, for reproducibility and audit.",
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/revisionId"
          },
          "classifier": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/policyVersion"
          }
        },
        "required": ["policy", "catalog"],
        "title": "DependencyVersions",
        "type": "object"
      },
      "durationMs": {
        "description": "Non-negative duration in whole milliseconds.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "title": "DurationMs",
        "type": "integer"
      },
      "effectivePolicy": {
        "additionalProperties": false,
        "description": "Resolved rule bound to the authenticated tenant with level-version provenance. Immutable once issued.",
        "properties": {
          "rule": {
            "$ref": "#/components/schemas/policyRule"
          },
          "tenant": {
            "$ref": "#/components/schemas/tenantId"
          },
          "versions": {
            "additionalProperties": false,
            "properties": {
              "application": {
                "$ref": "#/components/schemas/policyVersion"
              },
              "platform": {
                "$ref": "#/components/schemas/policyVersion"
              },
              "tenant": {
                "$ref": "#/components/schemas/policyVersion"
              }
            },
            "required": ["platform", "tenant"],
            "type": "object"
          }
        },
        "required": ["tenant", "rule", "versions"],
        "title": "EffectivePolicy",
        "type": "object"
      },
      "egressRule": {
        "additionalProperties": false,
        "description": "Allowed regions and providers for one traffic class. Completion and classifier egress are modeled independently.",
        "properties": {
          "providers": {
            "items": {
              "$ref": "#/components/schemas/providerFamily"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/regionCode"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": ["regions", "providers"],
        "title": "EgressRule",
        "type": "object"
      },
      "enabledToolSelection": {
        "additionalProperties": false,
        "description": "Enabled selection always names its catalog, even when empty. Split from toolSelection so Ajv strict mode sees a self-contained required property.",
        "properties": {
          "catalog": {
            "items": {
              "$ref": "#/components/schemas/toolDefinition"
            },
            "maxItems": 256,
            "type": "array"
          },
          "enabled": {
            "const": true
          }
        },
        "required": ["catalog"],
        "title": "EnabledToolSelection",
        "type": "object"
      },
      "endpointPolicy": {
        "additionalProperties": false,
        "description": "Where and through which providers a candidate may serve. Lists are explicit; emptiness is rejected rather than read as unrestricted.",
        "properties": {
          "allowsLocal": {
            "type": "boolean"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/providerFamily"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/regionCode"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": ["regions", "providers", "allowsLocal"],
        "title": "EndpointPolicy",
        "type": "object"
      },
      "errorCode": {
        "description": "Typed gateway error vocabulary. Unknown codes fail validation by design; consumers handle them by upgrading, not guessing.",
        "enum": [
          "INVALID_REQUEST",
          "POLICY_DENIED",
          "UNSUPPORTED_OPTION",
          "NO_ELIGIBLE_MODEL",
          "INSUFFICIENT_EVIDENCE",
          "ESSENTIAL_TOOLS_DO_NOT_FIT",
          "CLASSIFIER_UNAVAILABLE",
          "CATALOG_STALE",
          "CONTEXT_OVERFLOW",
          "BUDGET_EXCEEDED",
          "DEADLINE_EXCEEDED",
          "PROVIDER_UNAVAILABLE",
          "PROVIDER_PROTOCOL_ERROR",
          "STREAM_INTERRUPTED",
          "STALE_PREPARED_ROUTE",
          "IDEMPOTENCY_CONFLICT",
          "CANCELLED"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "evidenceKind": {
        "description": "Provenance class of a profile claim. Fixture evidence is synthetic and barred from production.",
        "enum": ["declared", "measured", "fixture"],
        "title": "EvidenceKind",
        "type": "string"
      },
      "evidenceRecord": {
        "additionalProperties": false,
        "description": "One sourced claim with observation time, optional expiry and sample size, and uncertainty. No unattributed specialization labels.",
        "properties": {
          "expiresAt": {
            "$ref": "#/components/schemas/timestamp"
          },
          "kind": {
            "$ref": "#/components/schemas/evidenceKind"
          },
          "observedAt": {
            "$ref": "#/components/schemas/timestamp"
          },
          "sampleCount": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "source": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "uncertainty": {
            "$ref": "#/components/schemas/fraction"
          }
        },
        "required": ["kind", "source", "observedAt"],
        "title": "EvidenceRecord",
        "type": "object"
      },
      "executionCertainty": {
        "description": "How certain Heimdall is that a billable provider call executed. A lost connection never proves zero cost.",
        "enum": ["not_started", "possibly_started", "started", "completed"],
        "title": "ExecutionCertainty",
        "type": "string"
      },
      "extensions": {
        "additionalProperties": false,
        "description": "Reserved forward-compatibility object. No keys are allowed in v1; each future key is an additive minor version change. Unknown keys are rejected, never silently dropped.",
        "maxProperties": 8,
        "properties": {},
        "title": "Extensions",
        "type": "object"
      },
      "fileBlock": {
        "additionalProperties": false,
        "description": "File/document requirement (text, PDF, archive, or other opaque document).",
        "properties": {
          "description": {
            "maxLength": 200000,
            "type": "string"
          },
          "mimeType": {
            "$ref": "#/components/schemas/mimeType"
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/urlSource"
              },
              {
                "$ref": "#/components/schemas/refSource"
              }
            ]
          },
          "type": {
            "const": "file"
          }
        },
        "required": ["type", "source"],
        "title": "FileBlock",
        "type": "object"
      },
      "fraction": {
        "description": "Exact decimal fraction between 0 and 1 inclusive.",
        "maxLength": 12,
        "pattern": "^(0(\\.\\d{1,9})?|1(\\.0{1,9})?)$",
        "title": "Fraction",
        "type": "string"
      },
      "heimdallError": {
        "additionalProperties": false,
        "description": "Typed error envelope. Certainty is per-occurrence, never inferred from the code alone.",
        "properties": {
          "attemptId": {
            "$ref": "#/components/schemas/attemptId"
          },
          "certainty": {
            "$ref": "#/components/schemas/executionCertainty"
          },
          "code": {
            "$ref": "#/components/schemas/errorCode"
          },
          "decisionId": {
            "$ref": "#/components/schemas/decisionId"
          },
          "extensions": {
            "$ref": "#/components/schemas/extensions"
          },
          "message": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "requestId": {
            "$ref": "#/components/schemas/requestId"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": ["code", "message", "retryable"],
        "title": "HeimdallError",
        "type": "object"
      },
      "imageBlock": {
        "additionalProperties": false,
        "description": "Image requirement. A description never erases the hard requirement to support the image itself.",
        "properties": {
          "description": {
            "maxLength": 200000,
            "type": "string"
          },
          "mimeType": {
            "$ref": "#/components/schemas/mimeType"
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/urlSource"
              },
              {
                "$ref": "#/components/schemas/refSource"
              }
            ]
          },
          "type": {
            "const": "image"
          }
        },
        "required": ["type", "source"],
        "title": "ImageBlock",
        "type": "object"
      },
      "invocationBudget": {
        "additionalProperties": false,
        "description": "Per-invocation money bounds plus optional advisory remaining task budget. Hard-cap admission and ledger mechanics belong to later tasks; transport defaults apply when absent.",
        "properties": {
          "hardCap": {
            "$ref": "#/components/schemas/money"
          },
          "remainingTaskBudget": {
            "$ref": "#/components/schemas/money"
          }
        },
        "title": "InvocationBudget",
        "type": "object"
      },
      "latencyLimits": {
        "additionalProperties": false,
        "description": "Application latency requirements. Numerical SLO values are calibrated before hosted rollout.",
        "properties": {
          "maxP99Ms": {
            "$ref": "#/components/schemas/durationMs"
          },
          "maxTimeToFirstTokenMs": {
            "$ref": "#/components/schemas/durationMs"
          }
        },
        "required": ["maxP99Ms"],
        "title": "LatencyLimits",
        "type": "object"
      },
      "message": {
        "additionalProperties": false,
        "description": "One canonical conversation message. Order within the messages array is significant and preserved by canonical hashing.",
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/contentBlock"
            },
            "maxItems": 256,
            "minItems": 1,
            "type": "array"
          },
          "name": {
            "maxLength": 64,
            "pattern": "^[\\w.-]{1,64}$",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/role"
          },
          "toolCallId": {
            "maxLength": 128,
            "pattern": "^[\\w.-]{1,128}$",
            "type": "string"
          }
        },
        "required": ["role", "content"],
        "title": "Message",
        "type": "object"
      },
      "mimeType": {
        "maxLength": 128,
        "pattern": "^[a-z]+/[a-z0-9.+-]+$",
        "title": "MimeType",
        "type": "string"
      },
      "mixedBlock": {
        "additionalProperties": false,
        "description": "Bounded mixed-modality content. Depth beyond nesting limits is rejected.",
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/contentBlock"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          },
          "type": {
            "const": "mixed"
          }
        },
        "required": ["type", "parts"],
        "title": "MixedBlock",
        "type": "object"
      },
      "modality": {
        "description": "All V1-declared modalities. Presence in the contract is not proof of runtime support; adapters advertise verified support only.",
        "enum": ["text", "image", "audio", "video", "file", "mixed"],
        "title": "Modality",
        "type": "string"
      },
      "modalitySupport": {
        "additionalProperties": false,
        "description": "Per-modality hard support. Every key is explicit; domain code maps an absent record to unknown, never to false.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/capabilityState"
          },
          "file": {
            "$ref": "#/components/schemas/capabilityState"
          },
          "image": {
            "$ref": "#/components/schemas/capabilityState"
          },
          "mixed": {
            "$ref": "#/components/schemas/capabilityState"
          },
          "text": {
            "$ref": "#/components/schemas/capabilityState"
          },
          "video": {
            "$ref": "#/components/schemas/capabilityState"
          }
        },
        "required": ["text", "image", "audio", "video", "file", "mixed"],
        "title": "ModalitySupport",
        "type": "object"
      },
      "modelPin": {
        "additionalProperties": false,
        "description": "Explicit candidate pin. Bypasses selection but never eligibility; fallback permission is unambiguous.",
        "properties": {
          "allowFallback": {
            "type": "boolean"
          },
          "candidate": {
            "$ref": "#/components/schemas/candidateId"
          }
        },
        "required": ["candidate", "allowFallback"],
        "title": "ModelPin",
        "type": "object"
      },
      "modelRef": {
        "additionalProperties": false,
        "description": "Model version or documented alias plus alias-resolution status. An unresolved live alias is recorded as such and limits reproducibility claims.",
        "properties": {
          "model": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "resolvedRevision": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "unresolvedAlias": {
            "type": "boolean"
          }
        },
        "required": ["model", "unresolvedAlias"],
        "title": "ModelRef",
        "type": "object"
      },
      "money": {
        "additionalProperties": false,
        "description": "Exact money value with declared currency.",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/decimalAmount"
          },
          "currency": {
            "$ref": "#/components/schemas/currency"
          }
        },
        "required": ["currency", "amount"],
        "title": "Money",
        "type": "object"
      },
      "policyOverride": {
        "additionalProperties": false,
        "description": "Partial tenant/application rule. Set fields narrow the platform rule; any widening is an explicit conflict error, never a silent relaxation.",
        "properties": {
          "allowlist": {
            "items": {
              "$ref": "#/components/schemas/candidateId"
            },
            "maxItems": 256,
            "type": "array"
          },
          "budgets": {
            "$ref": "#/components/schemas/budgetPolicy"
          },
          "classifierEgress": {
            "$ref": "#/components/schemas/egressRule"
          },
          "deniedCandidates": {
            "items": {
              "$ref": "#/components/schemas/candidateId"
            },
            "maxItems": 256,
            "type": "array"
          },
          "egress": {
            "$ref": "#/components/schemas/egressRule"
          },
          "latency": {
            "$ref": "#/components/schemas/latencyLimits"
          },
          "pin": {
            "$ref": "#/components/schemas/modelPin"
          },
          "quality": {
            "$ref": "#/components/schemas/qualityBaseline"
          },
          "reliability": {
            "$ref": "#/components/schemas/reliabilityFloor"
          },
          "riskMinimum": {
            "$ref": "#/components/schemas/riskTier"
          }
        },
        "title": "PolicyOverride",
        "type": "object"
      },
      "policyRule": {
        "additionalProperties": false,
        "description": "Complete effective rule for one scope. An empty allowlist constrains nothing; denials are explicit and union across levels.",
        "properties": {
          "allowlist": {
            "items": {
              "$ref": "#/components/schemas/candidateId"
            },
            "maxItems": 256,
            "type": "array"
          },
          "budgets": {
            "$ref": "#/components/schemas/budgetPolicy"
          },
          "classifierEgress": {
            "$ref": "#/components/schemas/egressRule"
          },
          "deniedCandidates": {
            "items": {
              "$ref": "#/components/schemas/candidateId"
            },
            "maxItems": 256,
            "type": "array"
          },
          "egress": {
            "$ref": "#/components/schemas/egressRule"
          },
          "latency": {
            "$ref": "#/components/schemas/latencyLimits"
          },
          "pin": {
            "$ref": "#/components/schemas/modelPin"
          },
          "quality": {
            "$ref": "#/components/schemas/qualityBaseline"
          },
          "reliability": {
            "$ref": "#/components/schemas/reliabilityFloor"
          },
          "riskMinimum": {
            "$ref": "#/components/schemas/riskTier"
          }
        },
        "required": [
          "allowlist",
          "quality",
          "latency",
          "reliability",
          "riskMinimum",
          "egress",
          "classifierEgress",
          "budgets"
        ],
        "title": "PolicyRule",
        "type": "object"
      },
      "policyVersion": {
        "description": "Opaque policy-version identifier.",
        "maxLength": 100,
        "pattern": "^pol_[A-Za-z0-9_-]{8,96}$",
        "title": "PolicyVersion",
        "type": "string"
      },
      "priceRate": {
        "additionalProperties": false,
        "description": "Exact price per one million units in the stated currency.",
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/currency"
          },
          "perMillionUnits": {
            "$ref": "#/components/schemas/decimalAmount"
          }
        },
        "required": ["currency", "perMillionUnits"],
        "title": "PriceRate",
        "type": "object"
      },
      "priceSchedule": {
        "additionalProperties": false,
        "description": "Effective-dated price record. Cross-rate currency consistency is checked in domain code, not in this schema.",
        "properties": {
          "cachedInput": {
            "$ref": "#/components/schemas/priceRate"
          },
          "effectiveAt": {
            "$ref": "#/components/schemas/timestamp"
          },
          "input": {
            "$ref": "#/components/schemas/priceRate"
          },
          "output": {
            "$ref": "#/components/schemas/priceRate"
          },
          "reasoning": {
            "$ref": "#/components/schemas/priceRate"
          },
          "request": {
            "$ref": "#/components/schemas/priceRate"
          }
        },
        "required": ["effectiveAt", "input", "output"],
        "title": "PriceSchedule",
        "type": "object"
      },
      "providerFamily": {
        "description": "Provider family key. Lowercase-hyphenated; vendor-neutral, never a vendor-specific core type.",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]{1,63}$",
        "title": "ProviderFamily",
        "type": "string"
      },
      "qualityBaseline": {
        "additionalProperties": false,
        "description": "Caller/profile-specific reference plus maximum tolerated regression as an exact fraction. Numerical values are calibrated in evaluation.",
        "properties": {
          "maxRegression": {
            "$ref": "#/components/schemas/fraction"
          },
          "reference": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["reference", "maxRegression"],
        "title": "QualityBaseline",
        "type": "object"
      },
      "reasonCode": {
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]{1,63}$",
        "title": "ReasonCode",
        "type": "string"
      },
      "reevaluationReason": {
        "description": "Typed caller reason for mid-task model reevaluation.",
        "enum": [
          "no_progress",
          "bad_output",
          "context_growth",
          "new_modality",
          "new_risk",
          "time_pressure",
          "budget_change",
          "provider_error",
          "user_request"
        ],
        "title": "ReevaluationReason",
        "type": "string"
      },
      "reevaluationRequest": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/reevaluationReason"
          }
        },
        "required": ["reason"],
        "title": "ReevaluationRequest",
        "type": "object"
      },
      "refSource": {
        "additionalProperties": false,
        "description": "Caller-held content reference. The gateway never dereferences it; adapters declare what they accept.",
        "properties": {
          "ref": {
            "maxLength": 1024,
            "pattern": "^[\\w./-]{1,1024}$",
            "type": "string"
          }
        },
        "required": ["ref"],
        "title": "RefSource",
        "type": "object"
      },
      "regionCode": {
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "RegionCode",
        "type": "string"
      },
      "reliabilityFloor": {
        "additionalProperties": false,
        "properties": {
          "minSuccessRate": {
            "$ref": "#/components/schemas/fraction"
          }
        },
        "required": ["minSuccessRate"],
        "title": "ReliabilityFloor",
        "type": "object"
      },
      "requestId": {
        "description": "Opaque gateway request identifier. No task-ID fields exist in V1; taskId/task_id/taskID are rejected as unknown properties.",
        "maxLength": 100,
        "pattern": "^req_[A-Za-z0-9_-]{8,96}$",
        "title": "RequestId",
        "type": "string"
      },
      "retentionInfo": {
        "additionalProperties": false,
        "description": "Whether a continuing task retained its model, and why.",
        "properties": {
          "reason": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "retained": {
            "type": "boolean"
          }
        },
        "required": ["retained"],
        "title": "RetentionInfo",
        "type": "object"
      },
      "revisionId": {
        "description": "Opaque profile-revision identifier.",
        "maxLength": 100,
        "pattern": "^rev_[A-Za-z0-9_-]{8,96}$",
        "title": "RevisionId",
        "type": "string"
      },
      "riskTier": {
        "description": "Caller-defined risk tier. Higher tiers require stronger evidence and can require caller-side validation; Heimdall never lowers a declared tier.",
        "enum": ["low", "standard", "high", "critical"],
        "title": "RiskTier",
        "type": "string"
      },
      "role": {
        "enum": ["system", "user", "assistant", "tool"],
        "title": "Role",
        "type": "string"
      },
      "routeRequest": {
        "additionalProperties": false,
        "description": "Native route request. Tenant identity comes from authentication context and has no body field. First-slice runtime support is text-only; other modalities are expressible and rejected by adapters until verified.",
        "properties": {
          "applicationProfile": {
            "$ref": "#/components/schemas/applicationProfile"
          },
          "budget": {
            "$ref": "#/components/schemas/invocationBudget"
          },
          "contextRequirements": {
            "$ref": "#/components/schemas/contextRequirements"
          },
          "deadlineMs": {
            "$ref": "#/components/schemas/durationMs"
          },
          "extensions": {
            "$ref": "#/components/schemas/extensions"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/message"
            },
            "maxItems": 512,
            "minItems": 1,
            "type": "array"
          },
          "modelPin": {
            "$ref": "#/components/schemas/modelPin"
          },
          "outputSchema": {
            "additionalProperties": true,
            "maxProperties": 64,
            "propertyNames": {
              "maxLength": 256
            },
            "type": "object"
          },
          "policyRef": {
            "$ref": "#/components/schemas/policyVersion"
          },
          "reevaluation": {
            "$ref": "#/components/schemas/reevaluationRequest"
          },
          "routingState": {
            "$ref": "#/components/schemas/routingState"
          },
          "toolSelection": {
            "$ref": "#/components/schemas/toolSelection"
          }
        },
        "required": ["applicationProfile", "policyRef", "messages"],
        "title": "RouteRequest",
        "type": "object"
      },
      "routeResult": {
        "additionalProperties": false,
        "description": "Native route result: the selected candidate, the exact visible tool set, ranked fallbacks, and the revised caller state. Cost estimation is filled by later tasks and optional until then.",
        "properties": {
          "candidateId": {
            "$ref": "#/components/schemas/candidateId"
          },
          "candidateRevision": {
            "$ref": "#/components/schemas/revisionId"
          },
          "decisionId": {
            "$ref": "#/components/schemas/decisionId"
          },
          "dependencyVersions": {
            "$ref": "#/components/schemas/dependencyVersions"
          },
          "estimatedCost": {
            "$ref": "#/components/schemas/money"
          },
          "rankedFallbacks": {
            "items": {
              "$ref": "#/components/schemas/candidateId"
            },
            "maxItems": 32,
            "type": "array"
          },
          "reasonCodes": {
            "items": {
              "$ref": "#/components/schemas/reasonCode"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array"
          },
          "retention": {
            "$ref": "#/components/schemas/retentionInfo"
          },
          "routingState": {
            "$ref": "#/components/schemas/routingState"
          },
          "selectedToolIds": {
            "items": {
              "$ref": "#/components/schemas/toolId"
            },
            "maxItems": 256,
            "type": "array"
          }
        },
        "required": [
          "decisionId",
          "candidateId",
          "selectedToolIds",
          "rankedFallbacks",
          "reasonCodes",
          "dependencyVersions",
          "routingState",
          "retention"
        ],
        "title": "RouteResult",
        "type": "object"
      },
      "routingState": {
        "additionalProperties": false,
        "description": "Compact caller-carried continuity data. Advisory for classification only: it carries no permissions, policy, allowlists, tenant identity, or task identifiers, and unknown fields are rejected.",
        "properties": {
          "evidenceRefs": {
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "objective": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "parentRevision": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "priorCandidate": {
            "$ref": "#/components/schemas/candidateId"
          },
          "stateVersion": {
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_.-]{1,32}$",
            "type": "string"
          }
        },
        "required": ["stateVersion", "objective"],
        "title": "RoutingState",
        "type": "object"
      },
      "safeCapacity": {
        "additionalProperties": false,
        "description": "Empirically safe token capacity with explicit output reserve, not advertised maxima.",
        "properties": {
          "outputReserveTokens": {
            "$ref": "#/components/schemas/tokenCount"
          },
          "safeInputTokens": {
            "$ref": "#/components/schemas/tokenCount"
          },
          "safeOutputTokens": {
            "$ref": "#/components/schemas/tokenCount"
          }
        },
        "required": ["safeInputTokens", "safeOutputTokens", "outputReserveTokens"],
        "title": "SafeCapacity",
        "type": "object"
      },
      "sideEffectClass": {
        "description": "Declared side-effect class. Selection may consider it; execution authorization stays with the caller, and Heimdall never executes tools.",
        "enum": ["read", "write", "external"],
        "title": "SideEffectClass",
        "type": "string"
      },
      "tenantId": {
        "description": "Authenticated tenant identifier. Resolved from authentication context, never from a request body field.",
        "maxLength": 100,
        "pattern": "^ten_[A-Za-z0-9_-]{8,96}$",
        "title": "TenantId",
        "type": "string"
      },
      "textBlock": {
        "additionalProperties": false,
        "description": "Plain text content. The only modality with first-slice runtime support; others are expressible but rejected by adapters until verified.",
        "properties": {
          "text": {
            "maxLength": 200000,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "const": "text"
          }
        },
        "required": ["type", "text"],
        "title": "TextBlock",
        "type": "object"
      },
      "timestamp": {
        "description": "RFC3339 date-time string with bounded length. The pattern checks field ranges (month, day, hour, minute, second, offset); impossible calendar dates such as February 30 pass the shape check and are a consumer concern.",
        "maxLength": 64,
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,9})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
        "title": "Timestamp",
        "type": "string"
      },
      "tokenCount": {
        "description": "Non-negative exact token count. Values above Number.MAX_SAFE_INTEGER are rejected as unsafe.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "title": "TokenCount",
        "type": "integer"
      },
      "toolDefinition": {
        "additionalProperties": false,
        "description": "One caller-authorized tool. Only selected definitions reach the model; order is significant and preserved.",
        "properties": {
          "bundle": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "essential": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/components/schemas/toolId"
          },
          "inputSchema": {
            "additionalProperties": true,
            "maxProperties": 128,
            "propertyNames": {
              "maxLength": 256
            },
            "type": "object"
          },
          "sideEffect": {
            "$ref": "#/components/schemas/sideEffectClass"
          },
          "tags": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          "version": {
            "$ref": "#/components/schemas/toolVersion"
          }
        },
        "required": ["id", "description", "inputSchema", "sideEffect", "version", "essential"],
        "title": "ToolDefinition",
        "type": "object"
      },
      "toolId": {
        "description": "Stable caller-assigned tool identifier.",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]{1,128}$",
        "title": "ToolId",
        "type": "string"
      },
      "toolSelection": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              },
              "required": ["enabled"]
            },
            "then": {
              "$ref": "#/components/schemas/enabledToolSelection"
            }
          }
        ],
        "description": "Optional tool filtering. Disabled means no selection: supplied authorized tools pass through subject to validation. Enabled requires a catalog (possibly empty) and returns only selected definitions, possibly none.",
        "properties": {
          "catalog": {
            "items": {
              "$ref": "#/components/schemas/toolDefinition"
            },
            "maxItems": 256,
            "type": "array"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["enabled"],
        "title": "ToolSelection",
        "type": "object"
      },
      "toolSupport": {
        "additionalProperties": false,
        "description": "Generic tool-calling and structured-output support. Measured success with specific catalogs is quality evidence, not part of this signal.",
        "properties": {
          "genericToolCalling": {
            "$ref": "#/components/schemas/capabilityState"
          },
          "structuredOutput": {
            "$ref": "#/components/schemas/capabilityState"
          }
        },
        "required": ["genericToolCalling", "structuredOutput"],
        "title": "ToolSupport",
        "type": "object"
      },
      "toolVersion": {
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.-]{1,64}$",
        "title": "ToolVersion",
        "type": "string"
      },
      "urlSource": {
        "additionalProperties": false,
        "description": "External content reference by URL. Server-side fetching, if ever needed, is allowlisted per adapter; no fetching exists in v1.",
        "properties": {
          "url": {
            "maxLength": 2048,
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": ["url"],
        "title": "UrlSource",
        "type": "object"
      },
      "videoBlock": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 200000,
            "type": "string"
          },
          "mimeType": {
            "$ref": "#/components/schemas/mimeType"
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/urlSource"
              },
              {
                "$ref": "#/components/schemas/refSource"
              }
            ]
          },
          "type": {
            "const": "video"
          }
        },
        "required": ["type", "source"],
        "title": "VideoBlock",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Heimdall contracts v1",
    "version": "1"
  },
  "openapi": "3.1.0"
}
